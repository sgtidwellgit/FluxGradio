# Copy this file to .env and fill in the paths for your own machine.
# .env is gitignored, so your local paths will never be committed.

# Local folder containing the FLUX.1-dev model weights (diffusers format).
FLUX_MODEL_PATH=C:\path\to\models\Flux

# Local folder containing the FLUX.1-Redux-dev model weights.
# Only needed if you plan to use the "Style (Redux)" reference mode.
FLUX_REDUX_MODEL_PATH=C:\path\to\models\FLUX.1-Redux-dev

# Folder where generated images will be saved.
FLUX_OUTPUT_DIR=C:\path\to\output
